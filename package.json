{
  "name": "leaper-hexapod",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "play": "node scripts/play.mjs",
    "test": "node --test tests/*.test.js",
    "test:brain": "node --test tests/leaper_world.test.js",
    "test:browser": "node tests/run-browser.mjs",
    "test:py": "node scripts/test-py.mjs",
    "lint": "eslint src tests scripts demos eslint.config.js vite.config.js",
    "assets": "node scripts/assets/build-assets.mjs && node scripts/assets/bake-junkyard-metrics.mjs",
    "assets:metrics": "node scripts/assets/bake-junkyard-metrics.mjs",
    "check": "pnpm build && pnpm test && pnpm test:browser"
  },
  "dependencies": {
    "onnxruntime-web": "^1.29.0",
    "three": "0.128.0",
    "three-mesh-bvh": "0.5.23"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "meshoptimizer": "1.3.0",
    "playwright": "1.56.1",
    "vite": "^7.0.0"
  }
}
